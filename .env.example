# Copy to .env and replace every value labelled CHANGE_ME. Never commit .env.
APP_ENV=development
APP_SECRET=CHANGE_ME_USE_AT_LEAST_32_RANDOM_CHARACTERS
COOKIE_SECURE=false
ELASTICSEARCH_URL=http://elasticsearch:9200
ELASTICSEARCH_USERNAME=elastic
ELASTICSEARCH_PASSWORD=CHANGE_ME_ELASTIC_PASSWORD
ELASTICSEARCH_INDEX_PREFIX=hivemind
# HiveMind self-hosts RoboHash; see k8s/robohash/.
AVATAR_BASE_URL=https://robohash.ahcomputing.com
ADMIN_USERNAME=admin
ADMIN_PASSWORD=CHANGE_ME_ADMIN_PASSWORD
# Paid summaries need a human-reviewed model ID and its verified current
# input/output prices.  A key and this 50 USD cap alone do not enable calls.
OPENAI_API_KEY=CHANGE_ME_LEAVE_DISABLED_UNTIL_CAP
OPENAI_SUMMARY_ENABLED=false
# Verified against OpenAI's GPT-6 Luna page on 2026-11-09 (Standard tier).
OPENAI_SUMMARY_MODEL=gpt-6-luna
OPENAI_INPUT_USD_PER_MILLION_TOKENS=0.10
OPENAI_OUTPUT_USD_PER_MILLION_TOKENS=0.50
OPENAI_MONTHLY_CAP_USD=50
OPENAI_SUMMARY_MAX_INPUT_TOKENS=12000
OPENAI_SUMMARY_MAX_OUTPUT_TOKENS=600
OPENAI_SUMMARY_TIMEOUT_SECONDS=30
EVOLUTION_ENABLED=false
EVOLUTION_SCHEDULE=
# Dash0/OpenTelemetry: default off. Keep the token only in a secret.
OTEL_SDK_DISABLED=true
OTEL_SERVICE_NAME=hivemind
OTEL_EXPORTER_OTLP_PROTOCOL=http/protobuf
OTEL_EXPORTER_OTLP_ENDPOINT=CHANGE_ME_DASH0_OTLP_HTTP_BASE_URL
# Example: authorization=Bearer auth_...,dash0-dataset=hivemind-production
OTEL_EXPORTER_OTLP_HEADERS=authorization=Bearer CHANGE_ME_DASH0_TOKEN,dash0-dataset=CHANGE_ME_DASH0_DATASET
